[sub_resource type="GDScript" id="GDScript_0xm2m"]
script/source = "
extends Path3D

@export var speed: float = 5.0
@export var acceleration: float = 1.5
@export var braking: float = 3.0

@export var train: Node3D
@export var wagon1: Node3D
@export var wagon2: Node3D

@export var wagon1_offset: float = 5.8
@export var wagon2_offset: float = 14.25

@export var locomotive_bogie_spacing: float = 1.5
@export var wagon_bogie_half_spacing: float = 1.5

var is_moving: bool = false
var current_speed: float = 0.0
var distance: float = 148.0


func _process(delta: float) -> void:
	var path_length: float = curve.get_baked_length()

	if path_length <= 0.0:
		return

	if Input.is_action_just_pressed(\"train_start\"):
		is_moving = true

	if Input.is_action_just_pressed(\"train_stop\"):
		is_moving = false

	if is_moving:
		current_speed = move_toward(
			current_speed, speed, acceleration * delta
		)
	else:
		current_speed = move_toward(
			current_speed, 0.0, braking * delta
		)

	distance = fposmod(
		distance + current_speed * delta, path_length
	)

	move_locomotive()
	move_vehicle(wagon1, wagon1_offset)
	move_vehicle(wagon2, wagon2_offset)


func move_locomotive() -> void:
	if train == null:
		return

	var path_length: float = curve.get_baked_length()
	var d: float = fposmod(distance, path_length)

	var position_now: Vector3 = to_global(curve.sample_baked(d))
	var next_d: float = fposmod(d + 0.1, path_length)
	var next_position: Vector3 = to_global(curve.sample_baked(next_d))

	train.global_position = position_now

	var direction: Vector3 = (next_position - position_now).normalized()
	train.global_rotation.y = atan2(-direction.x, -direction.z)

	move_locomotive_bogie(\"locomotive/bogiefront\", locomotive_bogie_spacing)
	move_locomotive_bogie(\"locomotive/bogierear\", -locomotive_bogie_spacing)


func move_locomotive_bogie(node_path: String, offset: float) -> void:
	if train == null:
		return

	var bogie: Node3D = train.get_node_or_null(node_path)
	if bogie == null:
		return

	var path_length: float = curve.get_baked_length()
	var d: float = fposmod(distance + offset, path_length)

	var point: Vector3 = to_global(curve.sample_baked(d))
	var next_d: float = fposmod(d + 0.1, path_length)
	var next_point: Vector3 = to_global(curve.sample_baked(next_d))

	bogie.global_position = point

	var direction: Vector3 = (next_point - point).normalized()
	bogie.global_rotation.y = atan2(-direction.x, -direction.z)


func move_vehicle(vehicle: Node3D, offset: float) -> void:
	if vehicle == null:
		return

	var path_length: float = curve.get_baked_length()
	var d: float = fposmod(distance - offset, path_length)

	var front_d: float = fposmod(d + wagon_bogie_half_spacing, path_length)
	var rear_d: float = fposmod(d - wagon_bogie_half_spacing, path_length)

	var front_position: Vector3 = to_global(curve.sample_baked(front_d))
	var rear_position: Vector3 = to_global(curve.sample_baked(rear_d))

	vehicle.global_position = (front_position + rear_position) / 2.0

	var body_direction: Vector3 = (front_position - rear_position).normalized()
	vehicle.global_rotation.y = atan2(-body_direction.x, -body_direction.z)

	move_wagon_bogie(vehicle, \"wheels/bogiefront\", front_d)
	move_wagon_bogie(vehicle, \"wheels/bogierear\", rear_d)


func move_wagon_bogie(
	vehicle: Node3D,
	node_path: String,
	bogie_distance: float
) -> void:
	var bogie: Node3D = vehicle.get_node_or_null(node_path)
	if bogie == null:
		return

	var path_length: float = curve.get_baked_length()
	var d: float = fposmod(bogie_distance, path_length)

	var point: Vector3 = to_global(curve.sample_baked(d))
	var next_d: float = fposmod(d + 0.1, path_length)
	var next_point: Vector3 = to_global(curve.sample_baked(next_d))

	bogie.global_position = point

	var direction: Vector3 = (next_point - point).normalized()
	bogie.global_rotation.y = atan2(-direction.x, -direction.z)
"

