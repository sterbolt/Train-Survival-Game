[sub_resource type="GDScript" id="GDScript_0xm2m"]
script/source = "
extends Path3D


# ============================================================
# 1. HITROST IN POSPEŠEVANJE
# ============================================================

@export var speed: float = 5.0
@export var acceleration: float = 1.5
@export var braking: float = 3.0
@export var speed_step_kmh: float = 5.0


# ============================================================
# 2. POVEZAVE DO VLAKA
# ============================================================

@export var train: Node3D
@export var wagon1: Node3D
@export var wagon2: Node3D
@export var speed_label: Label


# ============================================================
# 3. RAZDALJE MED VOZILI
# ============================================================

@export var wagon1_offset: float = 5.8
@export var wagon2_offset: float = 14.2

@export var locomotive_bogie_spacing: float = 1.5
@export var wagon_bogie_half_spacing: float = 1.5


# ============================================================
# 4. NASTAVITVE PROGE IN SMERI
# ============================================================

# Izključi za navadno odprto progo.
# Vključi samo, če je proga dejansko sklenjena.
@export var path_is_loop: bool = false

# Vključi, če je bila krivulja narisana v nasprotni
# smeri od želene smeri vožnje.
@export var reverse_path_direction: bool = false

# Godot standardno uporablja smer -Z.
# Vključi, če je sprednji del modela obrnjen proti lokalni +Z.
@export var model_front_is_positive_z: bool = false

# Začetna razdalja lokomotive na progi.
@export var start_distance: float = 0.0

# Razdalja za izračun smeri proge.
@export var direction_sample_distance: float = 0.25


# ============================================================
# 5. SPREMENLJIVKE
# ============================================================

var is_moving: bool = false
var current_speed: float = 0.0
var distance: float = 0.0
var path_length: float = 0.0


# ============================================================
# 6. ZAČETNA NASTAVITEV
# ============================================================

func _ready() -> void:

	if curve == null:
		push_error(\"Napaka: Path3D nima nastavljene krivulje.\")
		set_process(false)
		return

	path_length = curve.get_baked_length()

	if path_length <= 0.001:
		push_error(\"Napaka: Železniška proga nima veljavne dolžine.\")
		set_process(false)
		return

	if train == null:
		push_warning(\"Lokomotiva ni povezana v Inspectorju.\")

	if wagon1 == null:
		push_warning(\"Prvi vagon ni povezan v Inspectorju.\")

	if wagon2 == null:
		push_warning(\"Drugi vagon ni povezan v Inspectorju.\")

	if not InputMap.has_action(\"train_start\"):
		push_warning(\"Manjka dejanje train_start.\")

	if not InputMap.has_action(\"train_stop\"):
		push_warning(\"Manjka dejanje train_stop.\")

	# Začetni položaj.
	distance = normalize_distance(start_distance)

	# Vlak začne mirovat.
	current_speed = 0.0
	is_moving = false

	# Postavimo vse dele vlaka na pravilna mesta.
	move_locomotive()

	move_vehicle(wagon1, wagon1_offset)
	move_vehicle(wagon2, wagon2_offset)

	update_speed_display()


# ============================================================
# 7. SMER VOŽNJE
# ============================================================

func travel_sign() -> float:

	if reverse_path_direction:
		return -1.0

	return 1.0


# ============================================================
# 8. NORMALIZACIJA RAZDALJE
# ============================================================

func normalize_distance(value: float) -> float:

	if path_length <= 0.0:
		return 0.0

	if path_is_loop:
		return fposmod(value, path_length)

	return clampf(value, 0.0, path_length)


# ============================================================
# 9. POLOŽAJ NA PROGI
# ============================================================

func point_on_path(d: float) -> Vector3:

	var sample_distance: float = normalize_distance(d)

	var local_position: Vector3 = curve.sample_baked(
		sample_distance
	)

	return to_global(local_position)


# ============================================================
# 10. IZRAČUN SMERI PROGE
# ============================================================

func direction_on_path(d: float) -> Vector3:

	var sample_step: float = minf(
		maxf(direction_sample_distance, 0.01),
		path_length * 0.5
	)

	# Vzamemo točko pred trenutnim položajem.
	var position_before: Vector3 = point_on_path(
		d - sample_step
	)

	# Vzamemo točko za trenutnim položajem.
	var position_after: Vector3 = point_on_path(
		d + sample_step
	)

	# Izračunamo tangento proge.
	var direction: Vector3 = (
		position_after - position_before
	)

	# Če je proga narisana v nasprotni smeri,
	# obrnemo tudi smer gibanja.
	direction *= travel_sign()

	if direction.length_squared() < 0.000001:
		return Vector3(0.0, 0.0, -1.0) * travel_sign()

	return direction.normalized()


# ============================================================
# 11. PRAVILNA ROTACIJA MODELA
# ============================================================

func rotation_for_direction(direction: Vector3) -> float:

	var horizontal_direction: Vector3 = Vector3(
		direction.x,
		0.0,
		direction.z
	)

	if horizontal_direction.length_squared() < 0.000001:
		return 0.0

	horizontal_direction = horizontal_direction.normalized()

	# Model, katerega sprednji del kaže proti lokalni -Z.
	if not model_front_is_positive_z:

		return atan2(
			-horizontal_direction.x,
			-horizontal_direction.z
		)

	# Model, katerega sprednji del kaže proti lokalni +Z.
	return atan2(
		horizontal_direction.x,
		horizontal_direction.z
	)


# ============================================================
# 12. NASTAVITEV ROTACIJE VOZILA
# ============================================================

func set_node_direction(
	node: Node3D,
	direction: Vector3
) -> void:

	if node == null:
		return

	var rotation: Vector3 = node.global_rotation

	rotation.y = rotation_for_direction(direction)

	node.global_rotation = rotation


# ============================================================
# 13. PREMIKANJE LOKOMOTIVE
# ============================================================

func move_locomotive() -> void:

	if train == null:
		return

	var sign: float = travel_sign()

	# Položaja prednjega in zadnjega podstavka.
	var front_distance: float = (
		distance + locomotive_bogie_spacing * sign
	)

	var rear_distance: float = (
		distance - locomotive_bogie_spacing * sign
	)

	var front_position: Vector3 = point_on_path(
		front_distance
	)

	var rear_position: Vector3 = point_on_path(
		rear_distance
	)

	# Položaj sredine lokomotive.
	train.global_position = point_on_path(distance)

	# Usmeritev celotne lokomotive.
	var body_direction: Vector3 = (
		front_position - rear_position
	)

	if body_direction.length_squared() < 0.000001:
		body_direction = direction_on_path(distance)

	set_node_direction(
		train,
		body_direction
	)

	# Premik prednjega podstavka.
	move_bogie(
		train,
		NodePath(\"locomotive/bogiefront\"),
		front_distance
	)

	# Premik zadnjega podstavka.
	move_bogie(
		train,
		NodePath(\"locomotive/bogierear\"),
		rear_distance
	)


# ============================================================
# 14. PREMIKANJE VAGONOV
# ============================================================

func move_vehicle(
	vehicle: Node3D,
	offset: float
) -> void:

	if vehicle == null:
		return

	var sign: float = travel_sign()

	# Vagon je vedno za lokomotivo v smeri vožnje.
	var center_distance: float = (
		distance - absf(offset) * sign
	)

	var spacing: float = maxf(
		wagon_bogie_half_spacing,
		0.0
	)

	# Položaja obeh podstavkov.
	var front_distance: float = (
		center_distance + spacing * sign
	)

	var rear_distance: float = (
		center_distance - spacing * sign
	)

	var front_position: Vector3 = point_on_path(
		front_distance
	)

	var rear_position: Vector3 = point_on_path(
		rear_distance
	)

	# Položaj celotnega vagona.
	vehicle.global_position = (
		front_position + rear_position
	) / 2.0

	# Smer karoserije vagona.
	var body_direction: Vector3 = (
		front_position - rear_position
	)

	if body_direction.length_squared() < 0.000001:
		body_direction = direction_on_path(center_distance)

	set_node_direction(
		vehicle,
		body_direction
	)

	# Prednji podstavek.
	move_bogie(
		vehicle,
		NodePath(\"wheels/bogiefront\"),
		front_distance
	)

	# Zadnji podstavek.
	move_bogie(
		vehicle,
		NodePath(\"wheels/bogierear\"),
		rear_distance
	)


# ============================================================
# 15. PREMIKANJE POSAMEZNEGA PODSTAVKA
# ============================================================

func move_bogie(
	parent_node: Node3D,
	node_path: NodePath,
	bogie_distance: float
) -> void:

	if parent_node == null:
		return

	var found_node: Node = parent_node.get_node_or_null(
		node_path
	)

	if found_node == null:
		return

	var bogie: Node3D = found_node as Node3D

	if bogie == null:
		return

	# Položaj na progi.
	bogie.global_position = point_on_path(
		bogie_distance
	)

	# Pravilna smer podstavka.
	set_node_direction(
		bogie,
		direction_on_path(bogie_distance)
	)


# ============================================================
# 16. GLAVNO UPRAVLJANJE
# ============================================================

func _process(delta: float) -> void:

	if curve == null or path_length <= 0.001:
		return

	# ZAGON VLAKA.
	if InputMap.has_action(\"train_start\"):
		if Input.is_action_just_pressed(\"train_start\"):
			is_moving = true

	# USTAVITEV VLAKA.
	if InputMap.has_action(\"train_stop\"):
		if Input.is_action_just_pressed(\"train_stop\"):
			is_moving = false

	# POVEČANJE HITROSTI.
	if Input.is_action_just_pressed(\"ui_up\"):
		speed += speed_step_kmh / 3.6

	# ZMANJŠANJE HITROSTI.
	if Input.is_action_just_pressed(\"ui_down\"):
		speed = maxf(
			0.0,
			speed - speed_step_kmh / 3.6
		)

	# POSPEŠEVANJE ALI ZAVIRANJE.
	var target_speed: float = 0.0
	var movement_rate: float = 0.0

	if is_moving:

		target_speed = maxf(speed, 0.0)
		movement_rate = maxf(acceleration, 0.0)

	else:

		target_speed = 0.0
		movement_rate = maxf(braking, 0.0)

	current_speed = move_toward(
		current_speed,
		target_speed,
		movement_rate * delta
	)

	if current_speed < 0.0001:
		current_speed = 0.0

	# PREMIK PO PROGI.
	var next_distance: float = (
		distance + current_speed * delta * travel_sign()
	)

	if path_is_loop:

		distance = fposmod(
			next_distance,
			path_length
		)

	else:

		distance = clampf(
			next_distance,
			0.0,
			path_length
		)

		# Ustavitev na koncu odprte proge.
		if travel_sign() > 0.0 and next_distance >= path_length:
			is_moving = false
			current_speed = 0.0

		elif travel_sign() < 0.0 and next_distance <= 0.0:
			is_moving = false
			current_speed = 0.0

	# POSODOBITEV VOZIL.
	move_locomotive()

	move_vehicle(wagon1, wagon1_offset)
	move_vehicle(wagon2, wagon2_offset)

	update_speed_display()


# ============================================================
# 17. PRIKAZ HITROSTI
# ============================================================

func update_speed_display() -> void:

	if not is_instance_valid(speed_label):
		return

	var actual_speed: float = current_speed * 3.6
	var maximum_speed: float = speed * 3.6

	speed_label.text = (
		\"Hitrost: %.1f km/h\\nNajveč: %.1f km/h\"
		% [
			actual_speed,
			maximum_speed
		]
	)
