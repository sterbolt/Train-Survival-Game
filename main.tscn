.16484374, -5.433677, 0, 0, 0, 0, 0, 0, -82.418755, 0.16484374, -5.7121916, 0, 0, 0, 0, 0, 0, -82.42858, 0.16484374, -5.993983, 0, 0, 0, 0, 0, 0, -82.42277, 0.16484374, -6.308966, 0, 0, 0, 0, 0, 0, -82.42932, 0.16484374, -6.594034, 0, 0, 0, 0, 0, 0, -82.42932, 0.16484374, -6.8889318, 0, 0, 0, 0, 0, 0, -82.41884, 0.16484374, -7.185016, 0, 0, 0, 0, 0, 0, -82.428665, 0.16484374, -7.4831905, 0, 0, 0, 0, 0, 0, -82.44177, 0.16484374, -7.8010244),
