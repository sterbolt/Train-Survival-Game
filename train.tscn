[gd_scene format=3 uid="uid://chn0ssv1xxdfb"]

[sub_resource type="GDScript" id="GDScript_s75uv"]
script/source = "
extends Node3D

@onready var camera1: Camera3D = $locomotive/CabCamera
@onready var camera2: Camera3D = $locomotive/OutsideCamera
@onready var camera3: Camera3D = $locomotive/RearCamera
@onready var camera4: Camera3D = $locomotive/FrontCamera
var current_camera: int = 0

func _ready() -> void:
	switch_camera()

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"switch_camera\"):
		current_camera = (current_camera + 1) % 4
		switch_camera()

func switch_camera() -> void:
	var cameras: Array[Camera3D] = [camera1, camera2, camera3, camera4]
	cameras[current_camera].make_current()
"

